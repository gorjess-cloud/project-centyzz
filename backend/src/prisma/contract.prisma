// use prisma-8

model User {
  id                   Int                @id @default(autoincrement())
  email                String             @unique
  passwordHash         String
  firstName            String
  lastName             String
  role                 String             @default("STAFF")
  isActive             Boolean            @default(true)
  emailVerified        Boolean            @default(false)
  otpHash              String?
  otpExpiresAt         TimestamptzString?
  otpAttempts          Int                @default(0)
  resetPasswordToken   String?
  resetPasswordExpires TimestamptzString?
  archivedAt           TimestamptzString? @map("archived_at") // 👈 ADD THIS
  archivedBy           Int?               @map("archived_by") // 👈 ADD THIS
  archiveReason        String?            @map("archive_reason") // 👈 ADD THIS
  createdAt            TimestamptzString  @default(now())
  updatedAt            temporal.updatedAtString()
  appointments         Appointment[]

  @@map("user")
}


model PosTransaction {
  id         Int      @id @default(autoincrement())
  txnId      String   @unique @map("txn_id")
  txnTime    String   @map("txn_time")
  cashier    String
  service    String
  method     String
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("Completed")
  reportDate String   @map("report_date")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("pos_transactions")
}

model CloseoutReport {
  id               Int      @id @default(autoincrement())
  reportDate       String   @unique @map("report_date")
  registerId       String   @default("Register 1") @map("register_id")
  cashier          String   @default("Aljean Mark A. Angeles")
  shiftHours       String   @default("8:00 AM – 8:00 PM") @map("shift_hours")
  openingCash      Decimal  @default(5000.00) @db.Decimal(10, 2) @map("opening_cash")
  totalCashSales   Decimal  @default(0.00) @db.Decimal(10, 2) @map("total_cash_sales")
  totalDigitalSales Decimal @default(0.00) @db.Decimal(10, 2) @map("total_digital_sales")
  expectedCash     Decimal  @default(5000.00) @db.Decimal(10, 2) @map("expected_cash")
  actualCash       Decimal? @db.Decimal(10, 2) @map("actual_cash")
  discrepancy      Decimal  @default(0.00) @db.Decimal(10, 2)
  isClosed         Boolean  @default(false) @map("is_closed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("closeout_reports")
}

model Client {
  id              Int       @id @default(autoincrement())
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String
  phone           String?
  gender          String?
  tier            String    @default("REGULAR")
  lastVisit       DateTime? @map("last_visit")
  totalVisits     Int       @default(0) @map("total_visits")
  totalSpend      Decimal   @default(0.00) @db.Decimal(10, 2) @map("total_spend")
  favoriteService String?   @map("favorite_service")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  bookingHistory  Json?     @map("booking_history")
  archivedAt      DateTime? @map("archived_at")
  archivedBy      Int?      @map("archived_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("clients")
}


model Role {
  id       Int          @id @default(autoincrement())
  roleName VarChar(50)  @unique @map("role_name")

  @@map("roles")
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  name        VarChar(100) @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   TimestamptzString @default(now()) @map("updated_at")
  services    Service[]

  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid())
  category    String   // e.g., HAIR, NAILS, SKIN
  name        String   @unique
  duration    String   // e.g., "1 hr", "45 mins"
  price       String   // e.g., "₱1,800.00"
  status      String   @default("ACTIVE") // ACTIVE or INACTIVE
  isArchived  Boolean  @default(false)
  description String?
  dateCreated String   // e.g., "Aug 16, 2026"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Appointment {
  id             Int               @id @default(autoincrement())
  referenceCode  VarChar(30)?       @unique @map("reference_code")
  userId         Int?              @map("user_id")
  serviceId      Int               @map("service_id")
  customerName   VarChar(150)       @map("customer_name")
  customerEmail  VarChar(255)       @map("customer_email")
  appointmentDate String @map("appointment_date")
  startTime      TimeString         @map("start_time")
  endTime        TimeString         @map("end_time")
  status         VarChar(30)        @default("PENDING")
  notes          String?
  createdAt      TimestamptzString  @default(now()) @map("created_at")
  updatedAt      TimestamptzString  @default(now()) @map("updated_at")

  service        Service            @relation(fields: [serviceId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])

  @@map("appointments")
}

model Promo {
  id            Int               @id @default(autoincrement())
  code          VarChar(50)        @unique
  description   String?
  discountType  VarChar(20)        @map("discount_type")
  discountValue Decimal            @map("discount_value")
  minPurchase   Decimal            @default(0) @map("min_purchase")
  startsAt      TimestamptzString? @map("starts_at")
  expiresAt     TimestamptzString? @map("expires_at")
  usageLimit    Int?               @map("usage_limit")
  usageCount    Int               @default(0) @map("usage_count")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     TimestamptzString @default(now()) @map("created_at")
  updatedAt     TimestamptzString @default(now()) @map("updated_at")

  @@map("promos")
}