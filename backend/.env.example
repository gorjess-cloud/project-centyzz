# Copy to .env and replace every placeholder with your own local credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Use unique, randomly generated values. Never commit real secrets.
JWT_SECRET="replace-with-a-long-random-secret"
OTP_SECRET="replace-with-a-different-long-random-secret"

# SMTP is required for account registration and email verification.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="you@example.com"
SMTP_APP_PASSWORD="replace-with-an-app-password"

# Optional S3-compatible storage settings
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET=""
